APP_ORIGIN=http://127.0.0.1:43117
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:43117
# Exact comma-separated extra browser origins, including scheme and port.
# For a public deployment set BOTH canonical URLs above to its HTTPS origin.
# A proxy Host header does not automatically grant trust.
ALLOWED_ORIGINS=
# Enable only if your native MCP client needs OAuth dynamic client registration.
ENABLE_MCP_DCR=false
SOURCE_REPOSITORY_URL=
# Optional comma-separated extra hosts allowed to load Next.js dev resources.
ALLOWED_DEV_ORIGINS=
SENTINEL_DB_PATH=data/sentinel.sqlite
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
XAI_API_KEY=
# Server operator configures this once. Users create agents on-site without Grok accounts.
XAI_AGENT_MODEL=grok-4.7
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_REQUEST_TIMEOUT_SECONDS=45
AGENT_DAILY_RUN_LIMIT=200
XAI_VOICE_MODEL=grok-voice-latest
BANK_FRESHNESS_SECONDS=60
TASK_LEASE_SECONDS=300
VOICE_SESSION_SECONDS=900
VOICE_EPHEMERAL_SECONDS=300
WORKER_POLL_MS=1000
RECONCILE_MAX_ATTEMPTS=8
# Web listening port; changing it also requires updating the two canonical URLs.
PORT=43117

# Optional compatibility for sandbox providers that truncate fractional dollars.
# Displays whole-dollar product prices and blocks fractional purchase submissions.
NESSIE_WHOLE_DOLLARS_ONLY=false

# Explicit simulation: create completed Nessie records, verify readback, debit
# the independent Sentinel spending ledger. Does not prove provider settlement.
NESSIE_SIMULATE_COMPLETION=false
